{
  "version": "1.0",
  "disclaimer": "模板为参数化骨架，不含任何第三方仓库代码或图片素材；仅记录结构、映射与推荐规则。",
  "fields": {
    "id": "唯一标识",
    "name": "显示名",
    "category": "chart / diagram / composite",
    "chart_type": "对应 figure-document element.chart.chartType",
    "panels": "默认子图布局 [cols, rows]",
    "recommend_when": "数据特征匹配规则（供模板推荐器解释）",
    "default_mapping": "列角色默认映射",
    "characterization": "可选：表征谱图骨架（technique/x_reverse/x_scale/x_label/y_label/curves/fit_model/fit_source/peak_annotations/normalize/offset_each_series）；curves[].column 引用 default_mapping 的槽名，应用时解析为真实数据列",
    "journal_default": "默认套用的期刊预设 id",
    "palette_default": "默认配色 id",
    "notes": "使用说明"
  },
  "templates": [
    { "id": "tpl-bar", "name": "单系列柱状图", "category": "chart", "chart_type": "bar", "panels": [1, 1],
      "recommend_when": "1 个类别列(基数 2–12) 且 1 个数值列；类别基数小",
      "default_mapping": { "x": "第一列类别", "y": "数值列", "group": null },
      "journal_default": "nature-single", "palette_default": "npg",
      "notes": "适合组间比较；>12 类建议改条形图或折叠。" },
    { "id": "tpl-bar-grouped", "name": "分组柱状图", "category": "chart", "chart_type": "bar_grouped", "panels": [1, 1],
      "recommend_when": "1 类别列 + 1 分组列(基数≤4) + 1 数值列",
      "default_mapping": { "x": "类别列", "y": "数值列", "group": "分组列" },
      "journal_default": "nature-single", "palette_default": "npg",
      "notes": "分组数 >4 时改小多图。" },
    { "id": "tpl-bar-stacked", "name": "堆叠柱状图", "category": "chart", "chart_type": "bar_stacked", "panels": [1, 1],
      "recommend_when": "类别列 + 组分列 + 数值列，且组分求和有意义",
      "default_mapping": { "x": "类别列", "y": "数值列", "group": "组分列" },
      "journal_default": "nature-single", "palette_default": "npg",
      "notes": "组分≤5；超出改百分比堆叠或拆图。" },
    { "id": "tpl-line", "name": "折线图", "category": "chart", "chart_type": "line", "panels": [1, 1],
      "recommend_when": "1 个有序/时间列 + 1 数值列",
      "default_mapping": { "x": "时间/序号列", "y": "数值列" },
      "journal_default": "nature-single", "palette_default": "npg",
      "notes": "时间序列首选；点数 >2000 改抽稀或密度图。" },
    { "id": "tpl-line-multi", "name": "多折线图", "category": "chart", "chart_type": "line_multi", "panels": [1, 1],
      "recommend_when": "时间列 + 数值列 + 分组列(基数 2–6)",
      "default_mapping": { "x": "时间列", "y": "数值列", "group": "分组列" },
      "journal_default": "nature-single", "palette_default": "aaas",
      "notes": "线数 >6 改小多图或只高亮 1–2 条信号线。" },
    { "id": "tpl-scatter", "name": "散点图", "category": "chart", "chart_type": "scatter", "panels": [1, 1],
      "recommend_when": "2 个数值列",
      "default_mapping": { "x": "数值列 1", "y": "数值列 2" },
      "journal_default": "nature-single", "palette_default": "npg",
      "notes": "可叠加回归线与 R²/RMSE 注释。" },
    { "id": "tpl-marginal", "name": "边际散点图", "category": "chart", "chart_type": "marginal", "panels": [1, 1],
      "recommend_when": "2 个数值列且需要展示各自分布；n≥30",
      "default_mapping": { "x": "数值列 1", "y": "数值列 2" },
      "journal_default": "nature-single", "palette_default": "npg",
      "notes": "nature-skills 默认 120x105mm。" },
    { "id": "tpl-paired", "name": "配对比较图", "category": "chart", "chart_type": "paired", "panels": [1, 1],
      "recommend_when": "同一对象的两次测量（2 数值列或 1 数值列+2 水平）",
      "default_mapping": { "x": "条件列", "y": "数值列", "group": "个体 id 列" },
      "journal_default": "nature-single", "palette_default": "accent-duo",
      "notes": "nature-skills 默认 89x86mm；必须连线展示个体。" },
    { "id": "tpl-box", "name": "箱线图", "category": "chart", "chart_type": "box", "panels": [1, 1],
      "recommend_when": "类别列(基数 2–8) + 数值列",
      "default_mapping": { "x": "类别列", "y": "数值列" },
      "journal_default": "nature-single", "palette_default": "npg",
      "notes": "必须同时显示散点(jitter)，否则审稿常被质疑。" },
    { "id": "tpl-violin", "name": "小提琴图", "category": "chart", "chart_type": "violin", "panels": [1, 1],
      "recommend_when": "类别列 + 数值列，每组 n≥20 且需看分布形状",
      "default_mapping": { "x": "类别列", "y": "数值列" },
      "journal_default": "nature-single", "palette_default": "colorbrewer-set2",
      "notes": "n<20 时改用箱线+散点。" },
    { "id": "tpl-histogram", "name": "直方/密度图", "category": "chart", "chart_type": "histogram", "panels": [1, 1],
      "recommend_when": "1 个数值列，看分布",
      "default_mapping": { "x": "数值列" },
      "journal_default": "nature-single", "palette_default": "blues",
      "notes": "需标注 n 与分组带宽。" },
    { "id": "tpl-heatmap", "name": "热图", "category": "chart", "chart_type": "heatmap", "panels": [1, 1],
      "recommend_when": "矩阵数据（2 类别列 + 1 数值列）且需看整体模式",
      "default_mapping": { "x": "列类别", "y": "行类别", "color": "数值列" },
      "journal_default": "nature-single", "palette_default": "rdbu",
      "notes": "必须给色标与单位；发散数据用发散色板。" },
    { "id": "tpl-pie", "name": "饼图", "category": "chart", "chart_type": "pie", "panels": [1, 1],
      "recommend_when": "类别列(基数 3–6) + 占比列，且占比和为 100%",
      "default_mapping": { "x": "类别列", "y": "占比列" },
      "journal_default": "nature-single", "palette_default": "colorbrewer-set2",
      "notes": "期刊常不推荐饼图；>6 类改条形图。" },
    { "id": "tpl-dotplot", "name": "点图 (dotplot)", "category": "chart", "chart_type": "dotplot", "panels": [1, 1],
      "recommend_when": "类别列 + 数值列 + 可选尺寸/颜色列（富信息摘要）",
      "default_mapping": { "x": "数值列", "y": "类别列", "size": "可选列", "color": "可选列" },
      "journal_default": "nature-double", "palette_default": "npg",
      "notes": "nature-skills 默认 183x105mm。" },
    { "id": "tpl-roc", "name": "ROC 曲线", "category": "chart", "chart_type": "roc", "panels": [1, 1],
      "recommend_when": "二分类预测：真值列 + 得分列",
      "default_mapping": { "x": "FPR", "y": "TPR", "group": "模型列" },
      "journal_default": "nature-single", "palette_default": "aaas",
      "notes": "nature-skills 默认 89x89mm；须标 AUC 与 n。" },
    { "id": "tpl-volcano", "name": "火山图", "category": "chart", "chart_type": "volcano", "panels": [1, 1],
      "recommend_when": "差异分析：log2FC 列 + 显著性列(p/q)",
      "default_mapping": { "x": "log2FC", "y": "-log10(p)", "label": "基因名列" },
      "journal_default": "nature-single", "palette_default": "accent-duo",
      "notes": "nature-skills 默认 89x82mm；须标阈值线。" },
    { "id": "tpl-forest", "name": "森林图", "category": "chart", "chart_type": "forest", "panels": [1, 1],
      "recommend_when": "效应量 + 置信区间 + 研究/模型列",
      "default_mapping": { "x": "效应量", "y": "研究列", "error": "CI 列" },
      "journal_default": "nature-double", "palette_default": "npg",
      "notes": "置信区间必须可读；含零线参考。" },
    { "id": "tpl-survival", "name": "生存曲线", "category": "chart", "chart_type": "survival", "panels": [1, 1],
      "recommend_when": "时间列 + 事件列 + 分组列",
      "default_mapping": { "x": "时间列", "y": "生存率", "group": "分组列" },
      "journal_default": "nature-single", "palette_default": "nejm",
      "notes": "须给风险人数表与 HR/95%CI。" },
    { "id": "tpl-pca", "name": "PCA / 降维散点", "category": "chart", "chart_type": "pca", "panels": [1, 1],
      "recommend_when": "≥3 数值列 + 分组列",
      "default_mapping": { "x": "PC1", "y": "PC2", "group": "分组列" },
      "journal_default": "nature-single", "palette_default": "npg",
      "notes": "须标解释方差百分比。" },
    { "id": "tpl-venn", "name": "Venn / UpSet", "category": "chart", "chart_type": "venn", "panels": [1, 1],
      "recommend_when": "2–3 个集合成员标记列",
      "default_mapping": { "label": "集合列" },
      "journal_default": "nature-single", "palette_default": "colorbrewer-set2",
      "notes": ">4 集合改 UpSet。" },
    { "id": "tpl-sankey", "name": "桑基图", "category": "chart", "chart_type": "sankey", "panels": [1, 1],
      "recommend_when": "源列 + 目标列 + 权重列（流向）",
      "default_mapping": { "x": "源列", "y": "目标列", "size": "权重列" },
      "journal_default": "nature-double", "palette_default": "npg",
      "notes": "节点 ≤15，否则不可读。" },
    { "id": "tpl-taylor", "name": "Taylor 图", "category": "chart", "chart_type": "taylor", "panels": [1, 1],
      "recommend_when": "多模型评估：相关系数 + 标准差",
      "default_mapping": { "group": "模型列" },
      "journal_default": "nature-single", "palette_default": "npg",
      "notes": "气象/海洋领域常用。" },
    { "id": "tpl-graphical-abstract", "name": "四阶段 Graphical Abstract（合成示例）", "category": "diagram", "chart_type": "graphical_abstract", "panels": [1, 1],
      "recommend_when": "用户明确给出研究问题、方法、证据和结论的结构化 nodes/relations 与来源",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "只按原始实体关系参数生成原生矢量。内置四阶段是明确标注的合成示例，不是论文、官方三例或评测结果。" },
    { "id": "tpl-diagram-flow", "name": "流程示意图", "category": "diagram", "chart_type": "diagram_flow", "panels": [1, 1],
      "recommend_when": "无数据；用户提供步骤文字或参考图",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "内置原生形状（矩形/圆/箭头）+ 文本，禁止位图底图冒充矢量。" },
    { "id": "tpl-diagram-arch", "name": "模型/系统架构图", "category": "diagram", "chart_type": "diagram_architecture", "panels": [1, 1],
      "recommend_when": "无数据；用户提供模块清单或参考图",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "分层堆叠（数据层/编码器/解码器/输出）+ 实心箭头表示前向、虚线表示反馈。" },
    { "id": "tpl-composite-2x2", "name": "2x2 复合主图", "category": "composite", "chart_type": null, "panels": [2, 2],
      "recommend_when": "多组数据且存在 1 个主论点 + 3 个支撑面板",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "npg",
      "notes": "(a) 承担主论点；(b)(c)(d) 依次为对照/分解/验证。面板标签 8pt bold。" },
    { "id": "tpl-composite-1x3", "name": "1x3 横向复合图", "category": "composite", "chart_type": null, "panels": [3, 1],
      "recommend_when": "同类型指标在 3 个条件下的并列展示",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "aaas",
      "notes": "共享 y 轴；仅最左侧标注刻度值。" },
    { "id": "tpl-composite-schematic", "name": "示意图+量化 复合图", "category": "composite", "chart_type": null, "panels": [2, 1],
      "recommend_when": "上方机制示意、下方定量证据",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "(a) 示意 (b) 量化；上下面板宽度必须对齐（1.5pt 容差）。" },
    { "id": "tpl-diagram-pipeline", "name": "数据处理流水线", "category": "diagram", "chart_type": "diagram_flow", "panels": [1, 1],
      "recommend_when": "无数据；用户提供采集→清洗→训练→输出等线性多步骤处理链",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "横向单行步骤节点（矩形+实心箭头）；步骤文字为可编辑矢量元素，流向由用户摆放，不自动生成路由。" },
    { "id": "tpl-diagram-decision", "name": "判断分支流程图", "category": "diagram", "chart_type": "diagram_flow", "panels": [1, 1],
      "recommend_when": "无数据；流程含条件判断与是/否分支走向",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "菱形判断节点 + 是/否两条分支；分支文字可编辑，走向为手动布置的示意，不做自动布局。" },
    { "id": "tpl-diagram-loop", "name": "闭环迭代流程图", "category": "diagram", "chart_type": "diagram_flow", "panels": [1, 1],
      "recommend_when": "无数据；需要强调迭代闭环（如训练-验证-更新）",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "前向实心箭头 + 虚线反馈回路；回路起止由用户拖拽调整，不自动推导反馈逻辑。" },
    { "id": "tpl-diagram-experiment", "name": "实验流程图", "category": "diagram", "chart_type": "diagram_flow", "panels": [1, 1],
      "recommend_when": "无数据；实验设计叙述（分组→处理→测定→分析）",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "样本节点分叉为处理/对照两组再汇合到测定与分析；组名可改，分组依据由用户文字补充。" },
    { "id": "tpl-diagram-swimlane", "name": "泳道职责流程图", "category": "diagram", "chart_type": "diagram_flow", "panels": [1, 1],
      "recommend_when": "无数据；跨阶段/跨角色需要划分职责边界",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "两条泳道（平台/实验）内布置职责节点；泳道为背景矩形，节点与跨泳道箭头均为示意。" },
    { "id": "tpl-diagram-timeline", "name": "阶段时间线", "category": "diagram", "chart_type": "diagram_flow", "panels": [1, 1],
      "recommend_when": "无数据；按时间阶段描述研究/项目推进",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "横向时间轴 + 阶段里程碑节点；阶段名可编辑，刻度非真实时间数据。" },
    { "id": "tpl-diagram-hierarchy", "name": "层级分解架构图", "category": "diagram", "chart_type": "diagram_architecture", "panels": [1, 1],
      "recommend_when": "无数据；研究任务/软件模块自顶向下分解",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "根节点→子模块→子项两层层级树；层级由用户布局，不自动排树。" },
    { "id": "tpl-diagram-model", "name": "网络模型结构图", "category": "diagram", "chart_type": "diagram_architecture", "panels": [1, 1],
      "recommend_when": "无数据；深度模型输入→编码器→解码器→输出结构",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "块内横线表示堆叠层；层数为示意，块与连线均可编辑，前向实心箭头由用户布置。" },
    { "id": "tpl-diagram-compare", "name": "方案对比架构图", "category": "diagram", "chart_type": "diagram_architecture", "panels": [1, 1],
      "recommend_when": "无数据；基线方案与改进方案并列对比",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "nature-skills-6",
      "notes": "左右两列堆叠块各表示一条方案流水线；中间虚线箭头仅作对比提示，非自动映射。" },
    { "id": "tpl-composite-1x2-v", "name": "上下两联复合图", "category": "composite", "chart_type": null, "panels": [1, 2],
      "recommend_when": "主图在上、残差/延伸分析在下的两行版式",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "npg",
      "notes": "(a) 主结果 (b) 残差或次级分布；共享 x 轴时仅下面板标刻度。" },
    { "id": "tpl-composite-1x3-v", "name": "三行堆叠复合图", "category": "composite", "chart_type": null, "panels": [1, 3],
      "recommend_when": "同一 x 轴下三个条件/指标纵向对齐比较",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "aaas",
      "notes": "三行共享 x 轴；仅最左列标 y 刻度，行间距保持一致。" },
    { "id": "tpl-composite-1x4-v", "name": "纵向四联复合图", "category": "composite", "chart_type": null, "panels": [1, 4],
      "recommend_when": "四个时间点/处理梯度自上而下排列",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "okabe-ito",
      "notes": "(a)–(d) 纵向递进；适合条件逐级增强的展示。" },
    { "id": "tpl-composite-1x4-h", "name": "横向四联复合图", "category": "composite", "chart_type": null, "panels": [4, 1],
      "recommend_when": "同一指标在四个条件下的并列展示",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "npg",
      "notes": "(a)–(d) 从左到右；共享 y 轴，仅最左列标刻度。" },
    { "id": "tpl-composite-3x2", "name": "六面板复合图 (3列×2行)", "category": "composite", "chart_type": null, "panels": [3, 2],
      "recommend_when": "1 个主论点 + 5 个支撑面板的双行版式",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "npg",
      "notes": "(a) 主论点；(b)–(f) 对照/分解/验证；标签按行优先。" },
    { "id": "tpl-composite-2x3", "name": "六面板复合图 (2列×3行)", "category": "composite", "chart_type": null, "panels": [2, 3],
      "recommend_when": "面板较多且画布偏竖（3 行 2 列），如多基因/多脑区",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "colorbrewer-set2",
      "notes": "行优先标签 a–f；竖排适合双栏图的纵向空间。" },
    { "id": "tpl-composite-4x2", "name": "八面板复合图 (4列×2行)", "category": "composite", "chart_type": null, "panels": [4, 2],
      "recommend_when": "大型主图（8 面板，2 行 4 列）",
      "default_mapping": {},
      "journal_default": "nature-double", "palette_default": "aaas",
      "notes": "(a)–(h)；建议 1–2 个放大面板承载主论点，字号不小于 7pt。" },
    { "id": "tpl-composite-2x4", "name": "八面板复合图 (2列×4行)", "category": "composite", "chart_type": null, "panels": [2, 4],
      "recommend_when": "竖版八面板（4 行 2 列），适合整页图版",
